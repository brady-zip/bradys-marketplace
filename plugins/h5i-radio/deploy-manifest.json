{
  "schemaVersion": 1,
  "settingsPath": ".claude/settings.json",
  "objects": [
    {
      "id": "claude-radio-command",
      "type": "file",
      "source": "commands/radio.md",
      "dest": ".claude/commands/radio.md",
      "executable": false
    },
    {
      "id": "claude-radio-ask-skill",
      "type": "file",
      "source": "skills/radio-ask/SKILL.md",
      "dest": ".claude/skills/radio-ask/SKILL.md",
      "executable": false
    },
    {
      "id": "codex-radio-ask-skill",
      "type": "file",
      "source": "skills/radio-ask/SKILL.md",
      "dest": ".codex/skills/radio-ask/SKILL.md",
      "executable": false
    },
    {
      "id": "codex-radio-ask-openai",
      "type": "file",
      "source": "skills/radio-ask/agents/openai.yaml",
      "dest": ".codex/skills/radio-ask/agents/openai.yaml",
      "executable": false
    },
    {
      "id": "codex-radio-prompt",
      "type": "file",
      "source": "codex/prompts/radio.md",
      "dest": ".codex/prompts/radio.md",
      "executable": false
    },
    {
      "id": "identity-lock",
      "type": "file",
      "source": "scripts/identity-lock.sh",
      "dest": ".h5i-radio/identity-lock.sh",
      "executable": true
    },
    {
      "id": "codex-session-start-adapter",
      "type": "file",
      "source": "codex/hooks/h5i-codex-session-start.cjs",
      "dest": ".codex/hooks/h5i-codex-session-start.cjs",
      "executable": false
    },
    {
      "id": "codex-hooks-package",
      "type": "file",
      "source": "codex/hooks/package.json",
      "dest": ".codex/hooks/package.json",
      "executable": false
    },
    {
      "id": "codex-hooks-json",
      "type": "file",
      "source": "codex/hooks.json",
      "dest": ".codex/hooks.json",
      "executable": false,
      "noClobber": true
    },
    {
      "id": "h5i-agent-env",
      "type": "settings-fragment",
      "kind": "env",
      "key": "H5I_AGENT",
      "value": "claude"
    },
    {
      "id": "session-end-registration",
      "type": "settings-fragment",
      "kind": "hook",
      "event": "SessionEnd",
      "matchCommand": "identity-lock.sh",
      "entry": {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.h5i-radio/identity-lock.sh\" release-hook"
          }
        ]
      }
    }
  ]
}
