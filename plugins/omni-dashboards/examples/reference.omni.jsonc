                      }
                    }
                  ]
                }
              ]
            },
            {
              "instanceKey": "details",
              "type": "inline-text",
              "content": "## Details\nThe Team control excludes this table. Reconciliation with the headline requires matching control scope.",
              "textAlign": "start",
              "appearance": {
                "as": "inline"
