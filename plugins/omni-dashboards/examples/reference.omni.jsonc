            {
              "instanceKey": "divider",
              "type": "inline-divider",
              "direction": "horizontal"
            },
            {
              "instanceKey": "trends",
              "type": "inline-text",
              "content": "## Trends and comparisons\nUse one semantic count per bar; do not stack a total with its subset.",
              "textAlign": "start",
              "appearance": {
                "as": "inline"
              }
            },
            {
              "containerType": "stack",
              "instanceKey": "chart-row",
              "direction": "row",
              "gap": 2,
              "children": [
                {
