                      "as": "metadata",
                      "format": "subtitle",
                      "style": {
                        "height": "48px"
                      }
                    },
                    {
                      "instanceKey": "body-1",
                      "id": "1",
                      "type": "query",
                      "as": "chart",
                      "style": {
                        "fillSpace": true,
                        "minHeight": "96px"
                      }
                    }
                  ]
                },
                {
                  "containerType": "stack",
                  "instanceKey": "card-5",
                  "direction": "column",
                  "height": "240px",
                  "minHeight": "240px",
                  "fillSpace": true,
                  "gap": 0.5,
                  "children": [
                    {
                      "instanceKey": "title-5",
