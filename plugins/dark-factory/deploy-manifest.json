{
  "schemaVersion": 1,
  "settingsPath": ".claude/settings.json",
  "gsd": {
    "package": "@opengsd/gsd-core",
    "version": "1.6.1",
    "runtime": "codex",
    "scope": "full",
    "presenceMarker": ".codex/gsd-core"
  },
  "objects": [
    {
      "id": "claude-radio-command",
      "type": "file",
      "source": "commands/radio.md",
      "dest": ".claude/commands/radio.md",
      "executable": false
    },
    {
      "id": "claude-radio-ask-skill",
      "type": "file",
      "source": "skills/radio-ask/SKILL.md",
      "dest": ".claude/skills/radio-ask/SKILL.md",
      "executable": false
    },
    {
      "id": "codex-radio-ask-skill",
      "type": "file",
      "source": "skills/radio-ask/SKILL.md",
      "dest": ".codex/skills/radio-ask/SKILL.md",
      "executable": false
    },
    {
      "id": "codex-radio-ask-openai",
      "type": "file",
      "source": "skills/radio-ask/agents/openai.yaml",
      "dest": ".codex/skills/radio-ask/agents/openai.yaml",
      "executable": false
    },
    {
      "id": "claude-radio-review-skill",
      "type": "file",
      "source": "skills/radio-review/SKILL.md",
      "dest": ".claude/skills/radio-review/SKILL.md",
      "executable": false
    },
    {
      "id": "codex-radio-review-skill",
      "type": "file",
      "source": "skills/radio-review/SKILL.md",
      "dest": ".codex/skills/radio-review/SKILL.md",
      "executable": false
    },
    {
      "id": "codex-radio-review-openai",
      "type": "file",
      "source": "skills/radio-review/agents/openai.yaml",
      "dest": ".codex/skills/radio-review/agents/openai.yaml",
      "executable": false
    },
    {
      "id": "claude-radio-knowledge-skill",
      "type": "file",
      "source": "skills/radio-knowledge/SKILL.md",
      "dest": ".claude/skills/radio-knowledge/SKILL.md",
      "executable": false
    },
    {
      "id": "codex-radio-prompt",
      "type": "file",
      "source": "codex/prompts/radio.md",
      "dest": ".codex/prompts/radio.md",
      "executable": false
    },
    {
      "id": "gsd-h5i-claude-review-adapter",
      "type": "file",
      "source": "scripts/gsd-h5i-claude-review",
      "dest": ".dark-factory/gsd-h5i-claude-review",
      "executable": true
    },
    {
      "id": "claude-gsd-h5i-code-review-skill",
      "type": "file",
      "source": "skills/gsd-h5i-code-review/SKILL.md",
      "dest": ".claude/skills/gsd-h5i-code-review/SKILL.md",
      "executable": false
    },
    {
      "id": "codex-gsd-h5i-code-review-skill",
      "type": "file",
      "source": "skills/gsd-h5i-code-review/SKILL.md",
      "dest": ".codex/skills/gsd-h5i-code-review/SKILL.md",
      "executable": false
    },
    {
      "id": "codex-gsd-h5i-code-review-openai",
      "type": "file",
      "source": "skills/gsd-h5i-code-review/agents/openai.yaml",
      "dest": ".codex/skills/gsd-h5i-code-review/agents/openai.yaml",
      "executable": false
    },
    {
      "id": "identity-lock",
      "type": "file",
      "source": "scripts/identity-lock.sh",
      "dest": ".dark-factory/identity-lock.sh",
      "executable": true
    },
    {
      "id": "codex-session-start-adapter",
      "type": "file",
      "source": "codex/hooks/dark-factory-codex-session-start.cjs",
      "dest": ".codex/hooks/dark-factory-codex-session-start.cjs",
      "executable": false
    },
    {
      "id": "codex-hooks-package",
      "type": "file",
      "source": "codex/hooks/package.json",
      "dest": ".codex/hooks/package.json",
      "executable": false
    },
    {
      "id": "codex-sessionstart-hook",
      "type": "codex-hook-merge",
      "source": "codex/hooks.json",
      "dest": ".codex/hooks.json",
      "event": "SessionStart",
      "matchCommand": "dark-factory-codex-session-start.cjs"
    },
    {
      "id": "h5i-agent-env",
      "type": "settings-fragment",
      "kind": "env",
      "key": "H5I_AGENT",
      "value": "claude"
    },
    {
      "id": "session-end-registration",
      "type": "settings-fragment",
      "kind": "hook",
      "event": "SessionEnd",
      "matchCommand": "identity-lock.sh",
      "entry": {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.dark-factory/identity-lock.sh\" release-hook"
          }
        ]
      }
    }
  ]
}
