# mem0-brady config — EXTERNAL stack. Rendered by /mem0-brady:setup. chmod 600.
#
# This is the whole file on purpose. An external install drives mem0 entirely
# through the MCP server, so the server owns the Qdrant URL, the collection, the
# user_id, the embedding model and the API key. Duplicating any of them here
# would just be a second copy to keep in sync — and a wrong one is worse than a
# missing one, because it fails by quietly reading a different store.
#
# Re-running /mem0-brady:setup MERGES this file: your values are preserved and
# only missing keys are added, so hand-edits survive an upgrade.

MEM0_BRADY_STACK=external

# The mem0 MCP server. The hook wrappers export this as MEM0_MCP_URL, which is
# what the fork reads to choose the MCP client over an in-process mem0.
MEM0_BRADY_MCP_URL=__MCP_URL__

# Optional. Seconds before a hook gives up on the server. Hooks fail OPEN — a
# slow or dead server skips recall/capture rather than holding up the session —
# so this only bounds how long a session start can stall. Default 8.
# MEM0_MCP_TIMEOUT=8

# Optional. Extra request headers, as a JSON object, sent by BOTH clients (the
# fork's Python client and the shell scripts' curl client). Needed when the
# server sits behind an auth gate — e.g. a Cloudflare Access service token,
# which otherwise answers every hook with 401 and, because hooks fail open,
# looks exactly like memory being switched off.
#
# SINGLE-QUOTE THE VALUE. This file is `source`d, so a bare {"k":"v"} is a brace
# expansion whose quotes get stripped, and the client then sees invalid JSON and
# sends no headers at all — a silent 401.
# MEM0_MCP_HEADERS='{"CF-Access-Client-Id":"…","CF-Access-Client-Secret":"…"}'

# --- Capture policy -----------------------------------------------------------
# Master switches for the two things the Stop/PreCompact path produces. These are
# NOT the capture/handoff intervals: 0 there disables the DEBOUNCE, not the write.
#
# Leave them unset. The defaults come from CLAUDE_CODE_ENTRYPOINT, which matters
# most here — a cloud image carries ONE copy of this file, and the entrypoint is
# the only thing that distinguishes the containers booting from it:
#
#   remote_trigger (a scheduled routine)  capture off, handoff off
#   remote_desktop (an ad-hoc cloud task) capture on,  handoff on
#   cli / vscode / unset / anything else  capture on,  handoff on
#
# Setting either one here overrules that for EVERY container sharing this file,
# which is usually not what you want. Accepts 1/true/yes/on and 0/false/no/off;
# anything else keeps the default and logs a warning.
# MEM0_CAPTURE_ENABLED=0
# MEM0_HANDOFF_ENABLED=0
#
# Scope-inject writes made through the claude.ai CONNECTOR namespace
# (mcp__claude_ai_mem0__*), which otherwise carry no app_id and land outside the
# partition this session reads from. Opt-in: that path is reached by clients this
# plugin does not otherwise touch.
# MEM0_ENFORCE_CONNECTOR_TOOLS=1

# --- Scopes: how THIS machine slices the store ------------------------------
# Store identity is the server's business (above). How work is PARTITIONED is
# this machine's, because it depends on which repos and which agents live here.
# Resolution order, highest first — see hooks/lib-scope.sh, or run
# /mem0-brady:scopes to see what a given directory resolves to and why:
#
#   1. environment      an agent pinning its own identity at launch
#   2. .mem0-brady.json at/above the session cwd — what a checkout wants
#   3. the rules below  what this machine routes by default
#   4. 'general'        the plugin default; no repo names are baked in
#
# app_id — WHAT a memory is about. "app_id:glob" pairs joined by ';', first
# match wins, so put the most specific first. An app_id may not contain ':'
# or ';'. QUOTE THE WHOLE VALUE: this file is `source`d, so an unquoted ';'
# would end the assignment and run the rest as a command, and an unquoted '*'
# would glob against the current directory.
# MEM0_SCOPE_RULES='evergreen:*evergreen*;hal-ops:*/hal/*'
# MEM0_SCOPE_DEFAULT_APP=general
#
# agent_id — WHO is writing. Defaults to 'claude'. One project can host several
# agents (say a coding agent on app_id=storykeeper and an ops agent on
# app_id=storykeeper-ops) without cross-pollinating what each has learned; the
# ops agent pins its own by exporting MEM0_SCOPE_AGENT_ID before launching.
# MEM0_SCOPE_AGENT_ID=claude
#
# Recall defaults to the partition being written. Widen it when work genuinely
# spans partitions — usually per-repo, via "recall_app_ids" in .mem0-brady.json.
# MEM0_SCOPE_RECALL_APP_IDS=general
#
# run_id is NOT configured here: it is the active workstream, set per-session by
# /mem0-brady:workstream. See skills/workstream/SKILL.md.
