# mem0-brady config — single source of truth for the MCP server (launchd) AND
# the SessionStart/Stop hooks. Rendered by /mem0-brady:setup. chmod 600.
# Do not commit. Edit values here and restart the launchd agents + Claude session.
#
# Re-running /mem0-brady:setup MERGES this file: every value you have set is
# preserved, and only keys missing from your file are appended from the template.
# Hand-edits therefore survive an upgrade — but a key you DELETE will come back.

# --- Which stack backs this install? ----------------------------------------
# managed  : this plugin owns the whole stack — a native Qdrant binary and the
#            mem0 MCP server, both under launchd, on isolated ports. No Docker.
# external : you already run Qdrant + the mem0 MCP server yourself (e.g. a
#            docker-compose stack). Setup then installs ONLY the console scripts
#            and this config, and never touches launchd or downloads Qdrant.
MEM0_BRADY_STACK=__STACK__

# --- LLM (OpenAI) ---
MEM0_LLM_PROVIDER=openai
MEM0_LLM_MODEL=gpt-4o-mini

# --- Embedder (OpenAI) ---
# Changing the model or dims after any memory exists orphans every stored vector
# — the collection is created with a fixed size. Migrate, don't edit.
MEM0_EMBED_PROVIDER=openai
MEM0_EMBED_MODEL=text-embedding-3-small
MEM0_EMBED_DIMS=1536

# --- Reranker (in-process local CrossEncoder; deps ship with the fork install) ---
# Interactive search_memories reranks by default; the recall HOOKS force it off
# (the model would cold-load on every short-lived session-start process). Override
# per call with rerank=False. Comment out MEM0_RERANK_PROVIDER to disable entirely.
MEM0_RERANK_PROVIDER=sentence_transformer
MEM0_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Your OpenAI key (used by BOTH the LLM and the embedder) ---
OPENAI_API_KEY=__OPENAI_API_KEY__

# --- Graph store: off (no Neo4j) ---
MEM0_ENABLE_GRAPH=false

# --- Store identity (per-INSTALL, not baked into the plugin) ----------------
# MEM0_USER_ID is the ONE shared namespace every actor (you, Claude, Hal) reads
# and writes, so memories cross-query. Domain is partitioned by app_id
# (evergreen / general / hal-ops), set per-call (tools) or per-session (hooks),
# not here. Two installs that agree on MEM0_COLLECTION + MEM0_USER_ID and point
# at the same Qdrant share one memory. Changing MEM0_USER_ID on an install that
# already holds memories strands them — use /mem0-brady:migrate instead.
MEM0_COLLECTION=__COLLECTION__
MEM0_USER_ID=__USER_ID__

# --- Vector store -----------------------------------------------------------
# Both the MCP server AND the hooks connect over HTTP, so the store supports
# concurrent / multi-session access. (Embedded path mode can't — it takes an
# exclusive per-process lock.) The hooks instantiate mem0 DIRECTLY rather than
# going through the MCP server, so this URL must be reachable from your shell:
# an external stack has to publish Qdrant's port on the host, not only to a
# container network.
MEM0_QDRANT_URL=__QDRANT_URL__

# --- mem0 MCP server --------------------------------------------------------
# MEM0_HOST/MEM0_PORT configure the server this plugin RUNS (managed mode only);
# they are inert under an external stack, where you run the server yourself.
# MEM0_BRADY_MCP_URL is what CLIENTS connect to and what doctor checks — it is
# the one that matters in both modes.
MEM0_TRANSPORT=streamable-http
MEM0_HOST=127.0.0.1
MEM0_PORT=__MCP_PORT__
MEM0_BRADY_MCP_URL=__MCP_URL__

# --- Managed-mode launchd ports (ignored when MEM0_BRADY_STACK=external) -----
# Defaults dodge a personal Qdrant on 6333/6334. Changing these re-renders the
# launchd plist on the next /mem0-brady:setup.
MEM0_BRADY_QDRANT_HTTP_PORT=__QDRANT_HTTP_PORT__
MEM0_BRADY_QDRANT_GRPC_PORT=__QDRANT_GRPC_PORT__
