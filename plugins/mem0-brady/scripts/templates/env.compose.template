# mem0-brady config — COMPOSE stack. Rendered by /mem0-brady:setup. chmod 600.
#
# THIS FILE IS THE WHOLE CONFIGURATION. Nothing configurable lives in the plugin
# source tree. Two very different consumers read it, and both read THIS file:
#
#   1. the hooks, which `source` it (set -a; . file)
#   2. docker compose, via BOTH `--env-file` (interpolating the storage path and
#      host ports in docker-compose.yml) and `env_file:` (injecting the server's
#      own config into the container)
#
# That is the point: the stack and the hooks cannot drift, because there is only
# one file to drift from. It replaces an older split where the server's half
# lived at stack/.env inside the repo — which meant a live API key sat in a
# source checkout, and editing the wrong copy silently did nothing.
#
# QUOTING IS LOAD-BEARING. The two parsers agree on quoted values and disagree
# on bare ones: compose accepts `K=two words`, but `source` runs `words` as a
# command and leaves K empty. So any value containing a space, ';', '*', '{' or
# '#' MUST be quoted. Single quotes unless you want expansion. Verified: quoted
# values come back byte-identical from both parsers.
#
# Re-running /mem0-brady:setup MERGES this file: your values are preserved and
# only missing keys are added, so hand-edits survive an upgrade. Only the keys
# setup actively resolves (stack, URL, ports, storage, key) are rewritten —
# tuning like MEM0_LLM_MODEL is append-only and never clobbered.

MEM0_BRADY_STACK=compose

# The mem0 MCP server. The hook wrappers export this as MEM0_MCP_URL, which is
# what the fork reads to choose the MCP client over an in-process mem0.
MEM0_BRADY_MCP_URL=__MCP_URL__

# Optional. Seconds before a hook gives up on the server. Hooks fail OPEN — a
# slow or dead server skips recall/capture rather than holding up the session —
# so this only bounds how long a session start can stall. Default 8.
# MEM0_MCP_TIMEOUT=8

# Optional. Extra request headers, as a JSON object, sent by BOTH clients (the
# fork's Python client and the shell scripts' curl client). Needed when the
# server sits behind an auth gate — e.g. a Cloudflare Access service token,
# which otherwise answers every hook with 401 and, because hooks fail open,
# looks exactly like memory being switched off.
#
# SINGLE-QUOTE THE VALUE. A bare {"k":"v"} is a brace expansion to `source`.
# MEM0_MCP_HEADERS='{"CF-Access-Client-Id":"…","CF-Access-Client-Secret":"…"}'

# =============================================================================
# THE STACK — read by docker compose, not by the hooks
# =============================================================================

# Where Qdrant's data lives on the HOST. Absolute, and deliberately not derived
# from the plugin's location: vendoring the stack into the plugin repo must not
# move anybody's existing memories.
MEM0_BRADY_QDRANT_STORAGE=__QDRANT_STORAGE__

# Host ports, published on loopback only. The Qdrant one is NOT optional even
# though the hooks talk MCP: /mem0-brady:doctor and migrate.sh reach Qdrant
# directly from the host to count and export memories.
MEM0_BRADY_QDRANT_HOST_PORT=__QDRANT_HOST_PORT__
MEM0_BRADY_MCP_HOST_PORT=__MCP_HOST_PORT__

# Compose project name (containers are <project>-<service>-1). Renaming creates
# a SECOND set of containers against the same data — remove the old ones first.
# MEM0_BRADY_COMPOSE_PROJECT=mem0-host

# =============================================================================
# THE SERVER — injected into the container via `env_file:`
# =============================================================================

# --- LLM: memory extraction / fact derivation --------------------------------
# OpenAI, not Anthropic: this fork's Anthropic path returns empty facts (a
# JSON-shape mismatch in mem0's extractor), so infer=true writes silently no-op.
MEM0_PROVIDER=openai
MEM0_LLM_MODEL=__LLM_MODEL__

# Reasoning models reject temperature/max_tokens/top_p. mem0 detects them BY
# NAME and deliberately excludes the gpt-5.x family, because most of it does
# accept temperature — but not all of it does. Set this to true for a model that
# rejects them without matching the name heuristic, or extraction 400s on every
# call and infer=true stores nothing while looking healthy.
# Unset leaves mem0's own detection in charge.
# MEM0_LLM_IS_REASONING_MODEL=true
# MEM0_LLM_REASONING_EFFORT=medium

# --- Embeddings: hosted, so no local model and no Ollama container -----------
# MEM0_EMBED_DIMS must equal the width of the Qdrant collection. Changing the
# embedding model after data exists requires a fresh collection, not just a
# new value here.
MEM0_EMBED_PROVIDER=openai
MEM0_EMBED_MODEL=text-embedding-3-small
MEM0_EMBED_DIMS=1536

# Used by BOTH the LLM and the embedder, so the whole stack needs just one key.
OPENAI_API_KEY=__OPENAI_API_KEY__

# --- Vector store ------------------------------------------------------------
# COMPOSE-INTERNAL hostname — this is the container's view, not the host's.
# Host-side tooling uses 127.0.0.1:${MEM0_BRADY_QDRANT_HOST_PORT} instead. Same
# store, two vantage points; don't "fix" this to localhost.
MEM0_QDRANT_URL=http://qdrant:6333
MEM0_COLLECTION=__COLLECTION__

# The store namespace every actor reads and writes. The hooks read this too, so
# keeping it here — rather than only in the container — is what stops the host
# and the server from silently addressing two different namespaces.
MEM0_USER_ID=__USER_ID__

# --- Transport ---------------------------------------------------------------
MEM0_TRANSPORT=streamable-http
MEM0_HOST=0.0.0.0
MEM0_PORT=8081

# --- Graph memory off (enabling it adds a Neo4j container) -------------------
MEM0_ENABLE_GRAPH=false

# Steers what the fact-extractor considers worth storing (mem0 folds this into
# its extraction system prompt). Directions appended to message text do NOT
# work — they get stored as memories about being given directions.
# QUOTED because it contains spaces: bare, `source` would empty it.
MEM0_CUSTOM_INSTRUCTIONS='Extract only durable, reusable facts about the system: configuration values, endpoints, versions, identifiers, architectural decisions and their rationale, and gotchas that cost significant time. Write each fact as a standalone statement about the system itself. Never record that someone was told, advised, informed, confirmed, or asked something. Never record progress updates, status reports, or restatements of work just completed. If nothing meets this bar, return no facts.'

# =============================================================================
# CAPTURE POLICY + SCOPES — read only by the hooks
# =============================================================================

# Master switches for the two things the Stop/PreCompact path produces. These
# are NOT the capture/handoff intervals: 0 there disables the DEBOUNCE, not the
# write. Leave them unset — the defaults come from CLAUDE_CODE_ENTRYPOINT:
#
#   remote_trigger (a scheduled routine)  capture off, handoff off
#   remote_desktop (an ad-hoc cloud task) capture on,  handoff on
#   cli / vscode / unset / anything else  capture on,  handoff on
#
# Setting either here overrules that for EVERY container sharing this file.
# MEM0_CAPTURE_ENABLED=0
# MEM0_HANDOFF_ENABLED=0
#
# Scope-inject writes made through the claude.ai CONNECTOR namespace
# (mcp__claude_ai_mem0__*), which otherwise carry no app_id and land outside the
# partition this session reads from.
# MEM0_ENFORCE_CONNECTOR_TOOLS=1

# Capture cadence. The trivial-session floor is an AND gate — `user_total <
# MIN_USER_LEN AND asst_total < MIN_ASSISTANT_LEN` skips — so BOTH must be
# raised to skip more.
# MEM0_CAPTURE_MIN_INTERVAL=3600
# MEM0_MIN_USER_LEN=2000
# MEM0_MIN_ASSISTANT_LEN=1200

# --- Scopes: how THIS machine slices the store -------------------------------
# Store identity is above. How work is PARTITIONED is this machine's business,
# because it depends on which repos and which agents live here. Resolution
# order, highest first — run /mem0-brady:scopes to see what a directory
# resolves to and why:
#
#   1. environment      an agent pinning its own identity at launch
#   2. .mem0-brady.json at/above the session cwd — what a checkout wants
#   3. the rules below  what this machine routes by default
#   4. 'general'        the plugin default; no repo names are baked in
#
# app_id — WHAT a memory is about. "app_id:glob" pairs joined by ';', first
# match wins, so put the most specific first. An app_id may not contain ':'
# or ';'. QUOTE THE WHOLE VALUE: unquoted, ';' would end the assignment and run
# the rest as a command, and '*' would glob against the current directory.
# MEM0_SCOPE_RULES='evergreen:*evergreen*;hal-ops:*/hal/*'
# MEM0_SCOPE_DEFAULT_APP=general
#
# agent_id — WHO is writing. Defaults to 'claude'. One project can host several
# agents without cross-pollinating what each has learned.
# MEM0_SCOPE_AGENT_ID=claude
#
# Recall defaults to the partition being written. Widen it when work genuinely
# spans partitions — usually per-repo, via "recall_app_ids" in .mem0-brady.json.
# MEM0_SCOPE_RECALL_APP_IDS=general
#
# run_id is NOT configured here: it is the active workstream, set per-session by
# /mem0-brady:workstream. See skills/workstream/SKILL.md.
