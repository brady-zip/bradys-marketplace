# Copy to `.env` (gitignored) and fill in. Consumed by BOTH docker-compose
# (interpolation: the storage path and host ports) and the mem0-mcp container
# (env_file: everything else).

# --- Where Qdrant's data lives on the HOST (absolute path, required) ---------
# Deliberately absolute rather than relative to this file, so vendoring the
# stack into the plugin repo did not move anybody's existing memories. Point it
# at wherever your data already is.
MEM0_BRADY_QDRANT_STORAGE=/Users/you/dev/mem0-host/qdrant_storage

# --- Host ports (loopback only) ---------------------------------------------
# The Qdrant one is NOT optional if you use the mem0-brady plugin's hooks: they
# reach Qdrant directly from a host process, not through the MCP server.
MEM0_BRADY_QDRANT_HOST_PORT=6333
MEM0_BRADY_MCP_HOST_PORT=8081

# --- Compose project name (containers are <project>-<service>-1) -------------
# Defaults to mem0-host. Renaming creates a SECOND set of containers against the
# same data — remove the old ones first.
# MEM0_BRADY_COMPOSE_PROJECT=mem0-host

# --- LLM: memory extraction / fact derivation (hosted OpenAI) ---------------
# Use OpenAI, not Anthropic: this fork's Anthropic path returns empty facts
# (JSON-shape mismatch in mem0's extractor), so infer=true writes silently no-op.
# OpenAI reuses OPENAI_API_KEY below — so the whole stack needs just ONE key.
MEM0_PROVIDER=openai
MEM0_LLM_MODEL=gpt-4o-mini

# --- Embeddings: hosted OpenAI, so NO local model / no Ollama container ------
MEM0_EMBED_PROVIDER=openai
MEM0_EMBED_MODEL=text-embedding-3-small
MEM0_EMBED_DIMS=1536
OPENAI_API_KEY=sk-REPLACE_ME

# --- Vector store (compose-internal hostname, as seen BY THE CONTAINER) ------
# Not the same as the host URL the plugin's hooks use — that one is
# 127.0.0.1:${MEM0_BRADY_QDRANT_HOST_PORT}. Same store, two vantage points.
MEM0_QDRANT_URL=http://qdrant:6333
MEM0_COLLECTION=agent_memory

# --- Memory scoping: default user id for cross-agent shared memory ----------
# Must match MEM0_USER_ID in ~/.config/mem0-brady/.env, or the hooks and the
# MCP tools will write to two different namespaces in the same collection.
MEM0_USER_ID=brady

# --- Transport: remote-reachable HTTP ---------------------------------------
MEM0_TRANSPORT=streamable-http
MEM0_HOST=0.0.0.0
MEM0_PORT=8081

# --- Graph memory off for v1 (would add a Neo4j container) ------------------
MEM0_ENABLE_GRAPH=false

# --- What counts as a fact worth storing -------------------------------------
# mem0 folds this into its fact-extraction system prompt. It is the ONLY way to
# steer extraction: directions appended to the message text are treated as
# content and get stored as memories about being given directions.
MEM0_CUSTOM_INSTRUCTIONS=Extract only durable, reusable facts about the system: configuration values, endpoints, versions, identifiers, architectural decisions and their rationale, and gotchas that cost significant time. Write each fact as a standalone statement about the system itself. Never record that someone was told, advised, informed, confirmed, or asked something. Never record progress updates, status reports, or restatements of work just completed. If nothing meets this bar, return no facts.
